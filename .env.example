# Copy this file to .env and adjust. Placeholders only: never put real secrets here.

# Project
PROJECT_NAME=StreamPulse
ENVIRONMENT=development

# Kafka (topic renamed from food_orders: the data is Olist e-commerce orders)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=ecommerce_orders

# Files and folders (relative to the project root)
DATASET_PATH=data/raw
PARQUET_OUTPUT_DIR=data/processed/parquet
CHECKPOINT_DIR=data/checkpoints
DEAD_LETTER_DIR=data/dead_letter

# Replay (records per second, 0 = as fast as possible)
REPLAY_RATE=0
BATCH_SIZE=500

# PostgreSQL (local development defaults; change for anything beyond a demo)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=streampulse
POSTGRES_USER=streampulse
POSTGRES_PASSWORD=change_me

# External API: Frankfurter (currency rates) needs no key. API_KEY stays empty.
API_BASE_URL=https://api.frankfurter.dev/v2
API_KEY=
API_USER_AGENT=StreamPulse-student-project/1.0

# Spark
SPARK_APP_NAME=StreamPulseOrderStreaming

# Airflow web UI login (user: admin)
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_SECRET_KEY=change_me_to_a_random_string
